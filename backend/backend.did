type ToolCallArgument = 
 record {
   name: text;
   value: text;
 };
type ToolCall = 
 record {
   function: FunctionCall;
   id: text;
 };
type FunctionCall = 
 record {
   arguments: vec ToolCallArgument;
   name: text;
 };
type ChatMessage = 
 variant {
   assistant: AssistantMessage;
   system: record {content: text;};
   tool: record {
           content: text;
           tool_call_id: text;
         };
   user: record {content: text;};
 };
type AssistantMessage = 
 record {
   content: opt text;
   tool_calls: vec ToolCall;
 };
type TradeDecision =
 variant {
   approved;
   executed;
   failed;
   rejected;
 };
type TradeRecord =
 record {
   decision: TradeDecision;
   notionalUsd: float64;
   orderId: opt text;
   reason: text;
   side: text;
   symbol: text;
   timestampMs: int;
 };
service : {
  chat: (messages: vec ChatMessage) -> (text);
  getTradeLogs: () -> (vec TradeRecord) query;
  logTrade: (record: TradeRecord) -> ();
  prompt: (prompt: text) -> (text);
}
