# Copy to .env and fill in real values. Never commit .env.

# --- Pionex US Open API (trade-only key; no withdrawal/deposit scope) ---
PIONEX_US_BASE_URL=https://api.webot.com
PIONEX_US_API_KEY=
PIONEX_US_API_SECRET=
PIONEX_US_RPS=10

# --- ASI:One market data feed ---
ASI_ONE_ENDPOINT=
ASI_ONE_API_KEY=

# --- ICP trade log canister ---
ICP_TRADE_LOG_CANISTER_ID=
ICP_IDENTITY_PEM_PATH=
ICP_NETWORK_URL=https://icp0.io
ICP_TRADE_LOG_FALLBACK_PATH=agent/data/trade_log.jsonl

# --- Risk parameters ---
RISK_MAX_POSITION_USD=500
RISK_MAX_DAILY_LOSS_USD=50
RISK_MAX_EXPOSURE_PCT=0.25
RISK_VOLATILITY_CEILING=0.05
RISK_STOP_LOSS_PCT=0.02

# --- Agent behavior ---
# Keep false until Pionex US trade-only keys are provisioned and the
# strategy in agent/trading_agent.py has been reviewed.
LIVE_TRADING_ENABLED=false
AGENT_POLL_INTERVAL_SECONDS=60
TRADING_SYMBOLS=XRP_USDT
